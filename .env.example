# Copy to .env and fill in. Keys come from each sponsor console after redeeming your event code.
DAYTONA_API_KEY=
BRAINTRUST_API_KEY=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# Per-target credentials injected into the sandbox when a target's `sandbox_env` lists them
# (this is the "what a new developer would be handed" set for that vendor's quickstart):
ELEVENLABS_API_KEY=
COPILOTKIT_PUBLIC_API_KEY=
